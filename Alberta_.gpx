  <wpt lat="49.68439584100814" lon="-110.29303045241804">
    <name>Route Alternative</name>
    <cmt>control</cmt>
    <desc>Riders who need to take a bypass of Cypress park because of wet/muddy conditions can take Hwy 41 (Buffalo Trail) here north to road 515. Take this east to road 724 (entering Sask). Continue east to the town of Maple Creek and then go south on hwy 21 to rejoin the Sask route.</desc>
    <sym>Dot</sym>
    <type>checkpoint</type>
  </wpt>
  <wpt lat="50.74774182593609" lon="-115.24609523439716">
