  <wpt lat="50.07712999999999" lon="-110.79523">
    <name>Route Alternative</name>
    <cmt>control</cmt>
    <desc>Riders who want to avoid the trail option into town should continue east on this road (Broadway Ave W) and then take Sammis DR SE into town. Don't ride the trails if it has been raining as they are known for death mud. </desc>
    <sym>Dot</sym>
    <type>checkpoint</type>
  </wpt>
  <wpt lat="50.10203269292692" lon="-111.84421077170074">
