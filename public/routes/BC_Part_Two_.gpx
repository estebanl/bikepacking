  <wpt lat="49.43757452695031" lon="-119.0866572024359">
    <name>No Services</name>
    <cmt>caution</cmt>
    <desc>No services for next 225km to Naksup. So don't leave town without adequate provisions. But there are numerous areas to filter water along route</desc>
    <sym>Dot</sym>
    <type>danger</type>
  </wpt>
  <wpt lat="49.77543263933608" lon="-117.46795297679564">
    <name>Tunnel Collapse area</name>
    <cmt>caution</cmt>
    <desc>Pasable but may need to remove any panniers to squeeze bike through. Easier with two people.</desc>
    <sym>Dot</sym>
    <type>danger</type>
  </wpt>
  <wpt lat="49.80716625031741" lon="-119.3028053835879">
