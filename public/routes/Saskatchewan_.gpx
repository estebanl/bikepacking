  <wpt lat="49.6063" lon="-109.77876">
    <name>Route Alternative</name>
    <cmt>control</cmt>
    <desc>Riders who need a wet weather (less muddy) routing alternative can take road 615 south from here to Hwy 21 (red coat trail). Take this road east to Hwy 13 (also red coat trail). Go east to meet up with the route in Eastend.</desc>
    <sym>Dot</sym>
    <type>checkpoint</type>
  </wpt>
