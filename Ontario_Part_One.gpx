  <wpt lat="44.64930124963192" lon="-80.96425061625298">
    <name>East Linton Side Trail</name>
    <cmt>generic</cmt>
    <desc>Don't take the Sarawak switchbacks that are located beside this trail. It is much steeper. You want to take the East Linton Side Trail which is marked with trail blazers.</desc>
    <sym>Dot</sym>
    <type>generic</type>
  </wpt>
  <wpt lat="44.61577201407235" lon="-80.70293890530621">
    <name>This trail can be slimey </name>
    <cmt>caution</cmt>
    <sym>Dot</sym>
    <type>danger</type>
  </wpt>
  <wpt lat="44.79218979885362" lon="-80.98536237776061">
    <name>Big Puddles Possible</name>
    <cmt>caution</cmt>
    <desc>Road can be flooded in a couple of spots. If needed, can take shoes off and walk across puddles in sandals.</desc>
    <sym>Dot</sym>
    <type>danger</type>
  </wpt>
  <wpt lat="44.79177473296878" lon="-80.9929286309262">
    <name>Downhill - Rough and rocky in spots</name>
