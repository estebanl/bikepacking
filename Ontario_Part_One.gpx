  </wpt>
  <wpt lat="46.32235385569226" lon="-83.7905904248531">
    <name>Route Alternative</name>
    <cmt>control</cmt>
    <desc>If you don't need to go into Bruce Mines you can cut over here on Concession 5 Road to meet up with the route further along.</desc>
    <sym>Dot</sym>
    <type>checkpoint</type>
  </wpt>
  <wpt lat="46.14235569902223" lon="-81.75019575042819">
